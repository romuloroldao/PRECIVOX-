# ===========================================
# CONFIGURAÇÃO PRODUÇÃO - PRECIVOX
# ===========================================

# Ambiente
NODE_ENV=production

# URLs
NEXT_PUBLIC_URL=https://precivox.com.br

# JWT (TokenManager)
JWT_SECRET=altere-este-segredo-min-32-chars-em-producao

# Banco de dados
DATABASE_URL=postgresql://username:password@localhost:5432/precivox_production

# API Keys (se necessário)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL_REASONING=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b

# Configurações de produção
NEXT_PUBLIC_APP_URL=https://precivox.com.br
NEXT_PUBLIC_API_URL=https://precivox.com.br/api

# Shell AI-Native — manter false em produção até ciclo de piloto estável
# Shell AI-Native (Casa · Compra · Scanner · Despensa · Mais). Cookie AI_NATIVE_SHELL=0 desliga em QA.
NEXT_PUBLIC_AI_NATIVE_SHELL=true

# Configurações de segurança
NEXT_PUBLIC_ENVIRONMENT=production

# Logs
LOG_LEVEL=info
