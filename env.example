# Configurações do Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=precivox
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/precivox

# Configurações do Servidor
NODE_ENV=development
PORT=3001
JWT_SECRET=seu_jwt_secret_aqui

# URLs de API
# Em desenvolvimento: deixe vazio ou use http://localhost:3001
# Em produção: use https://precivox.com.br
NEXT_PUBLIC_API_URL=
API_URL=

# APIs Externas
GROQ_API_KEY=sua_groq_api_key_aqui
# Modelos Groq (opcional; defaults no código)
# GROQ_MODEL_REASONING=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
OPENCAGE_API_KEY=sua_opencage_api_key_aqui

# Configurações de Segurança
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Configurações de Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Imagens de produtos (Open Food Facts + storage local)
IMAGE_STORAGE_DIR=public/uploads/produtos
IMAGE_PUBLIC_BASE_URL=/uploads/produtos
OFF_USER_AGENT=Precivox/1.0 (contact@precivox.com.br)
IMAGE_BACKFILL_BATCH_SIZE=20

# Next.js
NEXT_PUBLIC_URL=http://localhost:3000

# Shell AI-Native (Fase 1) — dual-nav Casa/Compra/Scan/Despensa/Mais
# Default: false (nav legada). true = ativa shell novo. Cookie AI_NATIVE_SHELL=1 também liga em QA.
NEXT_PUBLIC_AI_NATIVE_SHELL=false

# Comunicação BFF (Next) -> Backend (Express)
INTERNAL_API_SECRET=defina_um_segredo_forte_compartilhado
BACKEND_INTERNAL_URL=http://localhost:3001

# ============================================
# Login Social (OAuth/OIDC) - validado no Express
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v19.0

# Sign in with Apple (Services ID + chave .p8)
APPLE_CLIENT_ID=        # Services ID (ex: com.precivox.web)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=      # conteúdo do .p8 (use \n para quebras de linha em uma única linha)

# Retorno ao app mobile (deep link)
MOBILE_DEEP_LINK=precivox://auth/callback

# ============================================
# OTP por telefone (SMS / WhatsApp) - Strategy
# OTP_PROVIDER: console | twilio | aws-sns | whatsapp
# ============================================
OTP_PROVIDER=console

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# AWS SNS (opcional)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# WhatsApp Business (Meta Cloud API) - futuro
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
