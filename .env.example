# PRECIVOX — variáveis para desenvolvimento local
# Copie para .env.local (Next.js carrega .env.local automaticamente):
#   cp .env.example .env.local
#
# Nunca commite .env.local nem use .env.production no `next dev`.

NODE_ENV=development

# URLs locais
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Segredos — mínimo 16 caracteres; gere com:
#   openssl rand -base64 32
JWT_SECRET=altere-este-valor-local-min-16-chars

# Banco local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/precivox_dev

# Opcional — Express BFF interno (não expor 3001 publicamente)
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001
# INTERNAL_API_SECRET=altere-interno

# Cron / seed (somente se usar essas rotas em dev)
# CRON_SECRET=
# SEED_SECRET=

# Imagens de produtos (Open Food Facts + storage local)
# IMAGE_STORAGE_DIR=public/uploads/produtos
# IMAGE_PUBLIC_BASE_URL=/uploads/produtos
# OFF_USER_AGENT=Precivox/1.0 (contact@precivox.com.br)
# IMAGE_BACKFILL_BATCH_SIZE=20

# OAuth (opcional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# E-mail transacional (SendGrid recomendado)
# SENDGRID_API_KEY=SG.xxxx   # preferido — usa smtp.sendgrid.net automaticamente
# SMTP_FROM=noreply@precivox.com.br
#
# Alternativa SMTP genérico:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@precivox.com.br

# Push / parceiro (opcional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PARTNER_API_KEYS=
